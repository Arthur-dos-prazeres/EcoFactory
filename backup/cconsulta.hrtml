<!DOCTYPE html>
<html lang="pt-BR">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Produção - Gestão de Máquinas</title>

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            background: #f5f7fb;
            color: #12233f;
        }

        /* =========================================
           ESTRUTURA
        ========================================= */

        .app {
            display: flex;
            min-height: 100vh;
        }


        /* =========================================
           MENU LATERAL
        ========================================= */

        .sidebar {
            width: 278px;
            min-height: 100vh;

            background: #071c35;

            color: white;

            display: flex;
            flex-direction: column;

            padding: 30px 14px;
        }


        .logo {
            display: flex;
            align-items: center;

            gap: 13px;

            padding: 0 10px;

            margin-bottom: 48px;
        }


        .logo-icon {
            width: 40px;
            height: 40px;

            background: white;

            border-radius: 8px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: #071c35;

            font-size: 22px;
        }


        .logo h2 {
            font-size: 19px;

            white-space: nowrap;
        }


        .menu {
            display: flex;
            flex-direction: column;

            gap: 8px;
        }


        .menu a {
            height: 48px;

            display: flex;
            align-items: center;

            gap: 15px;

            padding: 0 15px;

            border-radius: 8px;

            text-decoration: none;

            color: white;

            font-size: 16px;

            transition: .2s;
        }


        .menu a:hover {
            background: #12375f;
        }


        .menu a.active {
            background: #0968ed;
        }


        .icon {
            width: 25px;

            text-align: center;

            font-size: 20px;
        }


        .logout {
            margin-top: auto;
        }



        /* =========================================
           ÁREA PRINCIPAL
        ========================================= */

        .main {
            flex: 1;

            display: flex;
            flex-direction: column;

            min-width: 0;
        }



        /* =========================================
           TOPO
        ========================================= */

        .topbar {
            height: 76px;

            background: white;

            border-bottom: 1px solid #e1e5eb;

            display: flex;

            justify-content: flex-end;

            align-items: center;

            padding: 0 28px;

            gap: 25px;
        }


        .notification {
            position: relative;

            font-size: 24px;

            cursor: pointer;
        }


        .notification-number {
            position: absolute;

            top: -8px;
            right: -8px;

            width: 19px;
            height: 19px;

            border-radius: 50%;

            background: #0868ec;

            color: white;

            font-size: 11px;

            display: flex;
            justify-content: center;
            align-items: center;
        }


        .profile {
            display: flex;

            align-items: center;

            gap: 12px;
        }


        .profile img {
            width: 43px;
            height: 43px;

            border-radius: 50%;

            object-fit: cover;

            background: #ddd;
        }


        .arrow {
            font-size: 18px;
        }



        /* =========================================
           CONTEÚDO
        ========================================= */

        .content {
            padding: 30px 27px;

            flex: 1;
        }


        .page-title {
            font-size: 31px;

            margin-bottom: 13px;
        }


        .breadcrumb {
            display: flex;

            gap: 13px;

            font-size: 16px;

            margin-bottom: 25px;
        }


        .breadcrumb .active {
            color: #0968ed;
        }


        .breadcrumb .normal {
            color: #667085;
        }



        /* =========================================
           BOTÃO NOVA PRODUÇÃO
        ========================================= */

        .page-top {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 20px;
        }


        .page-top h2 {
            font-size: 21px;
        }


        .new-button {
            background: #0868ed;

            color: white;

            border: none;

            border-radius: 7px;

            padding: 14px 22px;

            font-size: 15px;

            cursor: pointer;

            font-weight: bold;

            transition: .2s;
        }


        .new-button:hover {
            background: #0056d8;
        }



        /* =========================================
           FILTROS
        ========================================= */

        .filter-card {
            background: white;

            border: 1px solid #dce2e9;

            border-radius: 8px;

            padding: 22px;

            margin-bottom: 20px;
        }


        .filter-title {
            font-size: 18px;

            margin-bottom: 20px;
        }


        .filters {
            display: grid;

            grid-template-columns:
                1.5fr
                1fr
                1fr
                1fr;

            gap: 20px;
        }


        .filter-group {
            display: flex;

            flex-direction: column;

            gap: 8px;
        }


        .filter-group label {
            font-size: 14px;

            font-weight: bold;
        }


        .input-wrapper {
            position: relative;
        }


        .filter-group input,
        .filter-group select {

            height: 50px;

            width: 100%;

            border: 1px solid #cfd6df;

            border-radius: 7px;

            padding: 0 14px;

            font-size: 14px;

            color: #667085;

            outline: none;

            background: white;
        }


        .filter-group input:focus,
        .filter-group select:focus {
            border-color: #0868ed;
        }


        .search-icon {
            position: absolute;

            right: 15px;

            top: 15px;

            font-size: 18px;

            color: #667085;
        }


        .filter-bottom {
            display: flex;

            justify-content: flex-end;

            margin-top: 15px;
        }


        .clear-button {
            height: 40px;

            padding: 0 17px;

            border: 1px solid #0868ed;

            color: #0868ed;

            background: white;

            border-radius: 6px;

            cursor: pointer;

            font-weight: bold;
        }


        .clear-button:hover {
            background: #f0f6ff;
        }



        /* =========================================
           TABELA
        ========================================= */

        .table-card {
            background: white;

            border: 1px solid #dce2e9;

            border-radius: 8px;

            overflow: hidden;
        }


        .table-header {
            height: 67px;

            padding: 0 20px;

            display: flex;

            align-items: center;

            justify-content: space-between;
        }


        .table-header h2 {
            font-size: 19px;
        }


        .total {
            color: #667085;

            font-size: 14px;
        }


        table {
            width: 100%;

            border-collapse: collapse;
        }


        thead {
            background: #f8fafc;
        }


        th {
            padding: 17px 18px;

            text-align: left;

            font-size: 13px;

            color: #14233c;

            border-top: 1px solid #e2e7ed;

            border-bottom: 1px solid #e2e7ed;

            white-space: nowrap;
        }


        td {
            padding: 17px 18px;

            border-bottom: 1px solid #e8ebef;

            font-size: 14px;

            white-space: nowrap;
        }


        tbody tr:hover {
            background: #fafcff;
        }



        /* =========================================
           STATUS
        ========================================= */

        .status {
            display: inline-block;

            padding: 7px 12px;

            border-radius: 6px;

            font-size: 12px;

            font-weight: bold;
        }


        .status.concluida {
            color: #0b9b43;

            background: #e5f8ec;
        }


        .status.andamento {
            color: #1463e8;

            background: #e5efff;
        }


        .status.parada {
            color: #e38a00;

            background: #fff1d9;
        }



        /* =========================================
           AÇÕES
        ========================================= */

        .actions {
            display: flex;

            gap: 7px;
        }


        .action-button {
            width: 36px;
            height: 36px;

            background: white;

            border: 1px solid #7ea9f9;

            border-radius: 6px;

            cursor: pointer;

            color: #0868ed;

            font-size: 16px;
        }


        .action-button:hover {
            background: #eef5ff;
        }


        .action-button.delete {
            border-color: #ff9696;

            color: #e32929;
        }


        .action-button.delete:hover {
            background: #fff1f1;
        }



        /* =========================================
           PAGINAÇÃO
        ========================================= */

        .table-footer {
            height: 62px;

            display: flex;

            justify-content: space-between;

            align-items: center;

            padding: 0 18px;

            color: #667085;

            font-size: 14px;
        }


        .pagination {
            display: flex;

            gap: 7px;
        }


        .page-button {
            width: 34px;
            height: 34px;

            background: white;

            border: 1px solid #dce2e9;

            border-radius: 6px;

            cursor: pointer;

            font-size: 14px;
        }


        .page-button.active {
            background: #0868ed;

            color: white;

            border-color: #0868ed;
        }


        .page-button:hover {
            background: #f0f5fc;
        }


        .page-button.active:hover {
            background: #0868ed;
        }



        /* =========================================
           RODAPÉ
        ========================================= */

        footer {
            height: 55px;

            border-top: 1px solid #e1e5eb;

            background: white;

            display: flex;

            justify-content: center;

            align-items: center;

            color: #667085;

            font-size: 13px;
        }



        /* =========================================
           MODAL
        ========================================= */

        .modal {
            display: none;

            position: fixed;

            inset: 0;

            background: rgba(0, 20, 40, .55);

            align-items: center;

            justify-content: center;

            padding: 20px;

            z-index: 1000;
        }


        .modal.show {
            display: flex;
        }


        .modal-content {
            width: 700px;

            max-width: 100%;

            background: white;

            border-radius: 10px;

            padding: 28px;

            box-shadow: 0 20px 50px rgba(0,0,0,.2);
        }


        .modal-header {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 25px;
        }


        .modal-header h2 {
            font-size: 22px;
        }


        .close {
            background: none;

            border: none;

            font-size: 28px;

            color: #667085;

            cursor: pointer;
        }


        .form-grid {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 18px;
        }


        .form-group {
            display: flex;

            flex-direction: column;

            gap: 7px;
        }


        .form-group.full {
            grid-column: 1 / -1;
        }


        .form-group label {
            font-size: 14px;

            font-weight: bold;
        }


        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;

            border: 1px solid #cfd6df;

            border-radius: 6px;

            padding: 12px;

            outline: none;

            font-size: 14px;
        }


        .form-group input,
        .form-group select {
            height: 44px;
        }


        .form-group textarea {
            min-height: 90px;

            resize: vertical;
        }


        .modal-buttons {
            display: flex;

            justify-content: flex-end;

            gap: 10px;

            margin-top: 25px;
        }


        .cancel {
            height: 43px;

            padding: 0 20px;

            background: white;

            border: 1px solid #cfd6df;

            border-radius: 6px;

            cursor: pointer;
        }


        .save {
            height: 43px;

            padding: 0 20px;

            background: #0868ed;

            color: white;

            border: none;

            border-radius: 6px;

            cursor: pointer;
        }



        /* =========================================
           RESPONSIVO
        ========================================= */

        @media(max-width: 1100px) {

            .sidebar {
                width: 220px;
            }

            .filters {
                grid-template-columns: 1fr 1fr;
            }

        }


        @media(max-width: 750px) {

            .sidebar {
                display: none;
            }

            .content {
                padding: 20px;
            }

            .page-top {
                flex-direction: column;

                align-items: flex-start;

                gap: 15px;
            }

            .filters {
                grid-template-columns: 1fr;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full {
                grid-column: auto;
            }

            .table-card {
                overflow-x: auto;
            }

            table {
                min-width: 1100px;
            }

        }

    </style>

</head>


<body>


<div class="app">


    <!-- =========================================
         SIDEBAR
    ========================================== -->

    <aside class="sidebar">


        <div class="logo">

            <div class="logo-icon">
                ⚙
            </div>

            <h2>
                Gestão de Máquinas
            </h2>

        </div>


        <nav class="menu">


            <a href="#">
                <span class="icon">⌂</span>
                Dashboard
            </a>


            <a href="#">
                <span class="icon">▣</span>
                Máquinas
            </a>


            <a href="#" class="active">
                <span class="icon">▥</span>
                Produção
            </a>


            <a href="#">
                <span class="icon">▤</span>
                Relatórios
            </a>


            <a href="#">
                <span class="icon">⚒</span>
                Manutenções
            </a>


            <a href="#">
                <span class="icon">♧</span>
                Alertas
            </a>


            <a href="#">
                <span class="icon">⚙</span>
                Configurações
            </a>


        </nav>


        <nav class="menu logout">

            <a href="#">
                <span class="icon">⇥</span>
                Sair
            </a>

        </nav>


    </aside>



    <!-- =========================================
         PRINCIPAL
    ========================================== -->

    <main class="main">


        <!-- TOPBAR -->

        <header class="topbar">


            <div class="notification">

                🔔

                <span class="notification-number">
                    3
                </span>

            </div>


            <div class="profile">

                <img
                    src="https://i.pravatar.cc/100?img=12"
                    alt="Usuário"
                >

                <span class="arrow">
                   ⌄
                </span>

            </div>


        </header>



        <!-- CONTEÚDO -->

        <section class="content">


            <h1 class="page-title">
                Produção
            </h1>


            <div class="breadcrumb">

                <span class="active">
                    Produção
                </span>

                <span>
                    ›
                </span>

                <span class="normal">
                    Consulta e Cadastro
                </span>

            </div>



            <!-- CABEÇALHO -->

            <div class="page-top">


                <h2>
                    Consulta de produção
                </h2>


                <button
                    class="new-button"
                    onclick="abrirModal()"
                >
                    ＋ Nova Produção
                </button>


            </div>



            <!-- =========================================
                 FILTROS
            ========================================== -->

            <div class="filter-card">


                <h3 class="filter-title">
                    Filtros de consulta
                </h3>


                <div class="filters">


                    <!-- PESQUISA -->

                    <div class="filter-group">

                        <label>
                            Pesquisar
                        </label>

                        <div class="input-wrapper">

                            <input
                                type="text"
                                id="pesquisa"
                                placeholder="Produto, máquina ou operador..."
                                onkeyup="filtrar()"
                            >

                            <span class="search-icon">
                                ⌕
                            </span>

                        </div>

                    </div>


                    <!-- DATA -->

                    <div class="filter-group">

                        <label>
                            Data
                        </label>

                        <input
                            type="date"
                            id="dataFiltro"
                            onchange="filtrar()"
                        >

                    </div>


                    <!-- MÁQUINA -->

                    <div class="filter-group">

                        <label>
                            Máquina
                        </label>

                        <select
                            id="maquinaFiltro"
                            onchange="filtrar()"
                        >

                            <option value="">
                                Todas as máquinas
                            </option>

                            <option>
                                Torno CNC 01
                            </option>

                            <option>
                                Fresa CNC 02
                            </option>

                            <option>
                                Prensa Hidráulica
                            </option>

                        </select>

                    </div>


                    <!-- STATUS -->

                    <div class="filter-group">

                        <label>
                            Status da produção
                        </label>

                        <select
                            id="statusFiltro"
                            onchange="filtrar()"
                        >

                            <option value="">
                                Todos os status
                            </option>

                            <option>
                                Concluída
                            </option>

                            <option>
                                Em andamento
                            </option>

                            <option>
                                Parada
                            </option>

                        </select>

                    </div>


                </div>


                <div class="filter-bottom">

                    <button
                        class="clear-button"
                        onclick="limparFiltros()"
                    >
                        ⚱ Limpar filtros
                    </button>

                </div>


            </div>



            <!-- =========================================
                 TABELA
            ========================================== -->

            <div class="table-card">


                <div class="table-header">

                    <h2>
                        Registros de produção
                    </h2>

                    <span
                        class="total"
                        id="total"
                    >
                        Total: 8 registros
                    </span>

                </div>



                <table>


                    <thead>

                        <tr>

                            <th>
                                Data
                            </th>

                            <th>
                                Produto
                            </th>

                            <th>
                                Máquina
                            </th>

                            <th>
                                Turno
                            </th>

                            <th>
                                Operador
                            </th>

                            <th>
                                Qtd. Produzida
                            </th>

                            <th>
                                Qtd. Rejeitada
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Ações
                            </th>

                        </tr>

                    </thead>



                    <tbody id="tabela">


                        <!-- LINHA 1 -->

                        <tr>

                            <td>
                                12/08/2025
                            </td>

                            <td>
                                Peça A-100
                            </td>

                            <td>
                                Torno CNC 01
                            </td>

                            <td>
                                1º Turno
                            </td>

                            <td>
                                João Silva
                            </td>

                            <td>
                                1.250
                            </td>

                            <td>
                                12
                            </td>

                            <td>

                                <span class="status concluida">
                                    Concluída
                                </span>

                            </td>

                            <td>

                                <div class="actions">

                                    <button
                                        class="action-button"
                                        onclick="visualizar(this)"
                                        title="Visualizar"
                                    >
                                        ◉
                                    </button>

                                    <button
                                        class="action-button"
                                        onclick="editar(this)"
                                        title="Editar"
                                    >
                                        ✎
                                    </button>

                                    <button
                                        class="action-button delete"
                                        onclick="excluir(this)"
                                        title="Excluir"
                                    >
                                        ♜
                                    </button>

                                </div>

                            </td>

                        </tr>



                        <!-- LINHA 2 -->

                        <tr>

                            <td>
                                12/08/2025
                            </td>

                            <td>
                                Peça B-200
                            </td>

                            <td>
                                Fresa CNC 02
                            </td>

                            <td>
                                2º Turno
                            </td>

                            <td>
                                Maria Santos
                            </td>

                            <td>
                                980
                            </td>

                            <td>
                                8
                            </td>

                            <td>

                                <span class="status andamento">
                                    Em andamento
                                </span>

                            </td>

                            <td>

                                <div class="actions">

                                    <button
                                        class="action-button"
                                        onclick="visualizar(this)"
                                    >
                                        ◉
                                    </button>

                                    <button
                                        class="action-button"
                                        onclick="editar(this)"
                                    >
                                        ✎
                                    </button>

                                    <button
                                        class="action-button delete"
                                        onclick="excluir(this)"
                                    >
                                        ♜
                                    </button>

                                </div>

                            </td>

                        </tr>



                        <!-- LINHA 3 -->

                        <tr>

                            <td>
                                11/08/2025
                            </td>

                            <td>
                                Peça C-300
                            </td>

                            <td>
                                Prensa Hidráulica
                            </td>

                            <td>
                                1º Turno
                            </td>

                            <td>
                                Carlos Lima
                            </td>

                            <td>
                                750
                            </td>

                            <td>
                                5
                            </td>

                            <td>

                                <span class="status parada">
                                    Parada
                                </span>

                            </td>

                            <td>

                                <div class="actions">

                                    <button
                                        class="action-button"
                                        onclick="visualizar(this)"
                                    >
                                        ◉
                                    </button>

                                    <button
                                        class="action-button"
                                        onclick="editar(this)"
                                    >
                                        ✎
                                    </button>

                                    <button
                                        class="action-button delete"
                                        onclick="excluir(this)"
                                    >
                                        ♜
                                    </button>

                                </div>

                            </td>

                        </tr>



                        <!-- LINHA 4 -->

                        <tr>

                            <td>
                                10/08/2025
                            </td>

                            <td>
                                Peça A-100
                            </td>

                            <td>
                                Torno CNC 01
                            </td>

                            <td>
                                3º Turno
                            </td>

                            <td>
                                Pedro Costa
                            </td>

                            <td>
                                1.100
                            </td>

                            <td>
                                10
                            </td>

                            <td>

                                <span class="status concluida">
                                    Concluída
                                </span>

                            </td>

                            <td>

                                <div class="actions">

                                    <button
                                        class="action-button"
                                        onclick="visualizar(this)"
                                    >
                                        ◉
                                    </button>

                                    <button
                                        class="action-button"
                                        onclick="editar(this)"
                                    >
                                        ✎
                                    </button>

                                    <button
                                        class="action-button delete"
                                        onclick="excluir(this)"
                                    >
                                        ♜
                                    </button>

                                </div>

                            </td>

                        </tr>



                        <!-- LINHA 5 -->

                        <tr>

                            <td>
                                10/08/2025
                            </td>

                            <td>
                                Peça D-400
                            </td>

                            <td>
                                Fresa CNC 02
                            </td>

                            <td>
                                2º Turno
                            </td>

                            <td>
                                Ana Oliveira
                            </td>

                            <td>
                                670
                            </td>

                            <td>
                                7
                            </td>

                            <td>

                                <span class="status andamento">
                                    Em andamento
                                </span>

                            </td>

                            <td>

                                <div class="actions">

                                    <button
                                        class="action-button"
                                        onclick="visualizar(this)"
                                    >
                                        ◉
                                    </button>

                                    <button
                                        class="action-button"
                                        onclick="editar(this)"
                                    >
                                        ✎
                                    </button>

                                    <button
                                        class="action-button delete"
                                        onclick="excluir(this)"
                                    >
                                        ♜
                                    </button>

                                </div>

                            </td>

                        </tr>


                    </tbody>

                </table>



                <!-- =====================================
                     RODAPÉ DA TABELA
                ====================================== -->

                <div class="table-footer">


                    <span id="exibindo">
                        Exibindo 1 a 5 de 8 registros
                    </span>


                    <div class="pagination">

                        <button class="page-button">
                            ‹
                        </button>

                        <button class="page-button active">
                            1
                        </button>

                        <button class="page-button">
                            2
                        </button>

                        <button class="page-button">
                            ›
                        </button>

                    </div>


                </div>


            </div>


        </section>



        <footer>

            © 2025 Gestão de Máquinas.
            Todos os direitos reservados.

        </footer>


    </main>

</div>



<!-- =========================================
     MODAL - NOVA PRODUÇÃO
========================================== -->

<div
    class="modal"
    id="modal"
>


    <div class="modal-content">


        <div class="modal-header">

            <h2>
                Nova Produção
            </h2>

            <button
                class="close"
                onclick="fecharModal()"
            >
                ×
            </button>

        </div>


        <form id="formProducao">


            <div class="form-grid">


                <div class="form-group">

                    <label>
                        Produto
                    </label>

                    <input
                        type="text"
                        id="produto"
                        placeholder="Ex.: Peça A-100"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Máquina
                    </label>

                    <select
                        id="maquina"
                        required
                    >

                        <option value="">
                            Selecione
                        </option>

                        <option>
                            Torno CNC 01
                        </option>

                        <option>
                            Fresa CNC 02
                        </option>

                        <option>
                            Prensa Hidráulica
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Data
                    </label>

                    <input
                        type="date"
                        id="data"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Turno
                    </label>

                    <select
                        id="turno"
                        required
                    >

                        <option value="">
                            Selecione
                        </option>

                        <option>
                            1º Turno
                        </option>

                        <option>
                            2º Turno
                        </option>

                        <option>
                            3º Turno
                        </option>

                    </select>

                </div>


                <div class="form-group">

                    <label>
                        Operador
                    </label>

                    <input
                        type="text"
                        id="operador"
                        placeholder="Nome do operador"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Quantidade produzida
                    </label>

                    <input
                        type="number"
                        id="quantidade"
                        min="0"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Quantidade rejeitada
                    </label>

                    <input
                        type="number"
                        id="rejeitada"
                        min="0"
                        value="0"
                    >

                </div>


                <div class="form-group">

                    <label>
                        Status
                    </label>

                    <select
                        id="status"
                        required
                    >

                        <option value="">
                            Selecione
                        </option>

                        <option>
                            Concluída
                        </option>

                        <option>
                            Em andamento
                        </option>

                        <option>
                            Parada
                        </option>

                    </select>

                </div>


                <div class="form-group full">

                    <label>
                        Observações
                    </label>

                    <textarea
                        id="observacoes"
                        placeholder="Digite uma observação..."
                    ></textarea>

                </div>


            </div>


            <div class="modal-buttons">

                <button
                    type="button"
                    class="cancel"
                    onclick="fecharModal()"
                >
                    Cancelar
                </button>

                <button
                    type="submit"
                    class="save"
                >
                    Salvar produção
                </button>

            </div>


        </form>


    </div>

</div>



<script>

    /* =========================================
       MODAL
    ========================================== */

    function abrirModal() {

        document
            .getElementById("modal")
            .classList.add("show");

    }


    function fecharModal() {

        document
            .getElementById("modal")
            .classList.remove("show");

    }



    /* =========================================
       CADASTRO
    ========================================== */

    document
        .getElementById("formProducao")
        .addEventListener("submit", function(event) {

            event.preventDefault();


            const produto =
                document.getElementById("produto").value;

            const maquina =
                document.getElementById("maquina").value;

            const data =
                document.getElementById("data").value;

            const turno =
                document.getElementById("turno").value;

            const operador =
                document.getElementById("operador").value;

            const quantidade =
                document.getElementById("quantidade").value;

            const rejeitada =
                document.getElementById("rejeitada").value;

            const status =
                document.getElementById("status").value;


            if (
                !produto ||
                !maquina ||
                !data ||
                !turno ||
                !operador ||
                !quantidade ||
                !status
            ) {

                alert(
                    "Preencha todos os campos obrigatórios."
                );

                return;

            }


            const dataFormatada =
                data
                    .split("-")
                    .reverse()
                    .join("/");


            let classe = "concluida";


            if (status === "Em andamento") {

                classe = "andamento";

            }

            if (status === "Parada") {

                classe = "parada";

            }


            const tabela =
                document.getElementById("tabela");


            const linha =
                document.createElement("tr");


            linha.innerHTML = `

                <td>${dataFormatada}</td>

                <td>${produto}</td>

                <td>${maquina}</td>

                <td>${turno}</td>

                <td>${operador}</td>

                <td>${Number(quantidade).toLocaleString("pt-BR")}</td>

                <td>${rejeitada}</td>

                <td>
                    <span class="status ${classe}">
                        ${status}
                    </span>
                </td>

                <td>

                    <div class="actions">

                        <button
                            class="action-button"
                            onclick="visualizar(this)"
                        >
                            ◉
                        </button>

                        <button
                            class="action-button"
                            onclick="editar(this)"
                        >
                            ✎
                        </button>

                        <button
                            class="action-button delete"
                            onclick="excluir(this)"
                        >
                            ♜
                        </button>

                    </div>

                </td>

            `;


            tabela.insertBefore(
                linha,
                tabela.firstChild
            );


            atualizarTotal();


            document
                .getElementById("formProducao")
                .reset();


            fecharModal();


            alert(
                "Produção cadastrada com sucesso!"
            );

        });



    /* =========================================
       EXCLUIR
    ========================================== */

    function excluir(botao) {

        const confirmar =
            confirm(
                "Deseja realmente excluir esta produção?"
            );


        if (confirmar) {

            botao
                .closest("tr")
                .remove();

            atualizarTotal();

        }

    }



    /* =========================================
       VISUALIZAR
    ========================================== */

    function visualizar(botao) {

        const linha =
            botao.closest("tr");

        const celulas =
            linha.querySelectorAll("td");


        alert(

            "PRODUÇÃO\n\n" +

            "Data: " +
            celulas[0].innerText +

            "\nProduto: " +
            celulas[1].innerText +

            "\nMáquina: " +
            celulas[2].innerText +

            "\nTurno: " +
            celulas[3].innerText +

            "\nOperador: " +
            celulas[4].innerText +

            "\nQuantidade produzida: " +
            celulas[5].innerText +

            "\nQuantidade rejeitada: " +
            celulas[6].innerText +

            "\nStatus: " +
            celulas[7].innerText

        );

    }



    /* =========================================
       EDITAR
    ========================================== */

    function editar(botao) {

        alert(
            "Função de edição selecionada."
        );

    }



    /* =========================================
       FILTROS
    ========================================== */

    function filtrar() {

        const pesquisa =
            document
                .getElementById("pesquisa")
                .value
                .toLowerCase();


        const maquina =
            document
                .getElementById("maquinaFiltro")
                .value
                .toLowerCase();


        const status =
            document
                .getElementById("statusFiltro")
                .value
                .toLowerCase();


        const data =
            document
                .getElementById("dataFiltro")
                .value;


        const linhas =
            document.querySelectorAll(
                "#tabela tr"
            );


        let encontrados = 0;


        linhas.forEach(function(linha) {

            const texto =
                linha.innerText.toLowerCase();


            let mostrar = true;


            if (
                pesquisa &&
                !texto.includes(pesquisa)
            ) {

                mostrar = false;

            }


            if (
                maquina &&
                !texto.includes(maquina)
            ) {

                mostrar = false;

            }


            if (
                status &&
                !texto.includes(status)
            ) {

                mostrar = false;

            }


            if (data) {

                const dataBrasil =
                    data
                        .split("-")
                        .reverse()
                        .join("/");


                if (
                    !texto.includes(dataBrasil)
                ) {

                    mostrar = false;

                }

            }


            if (mostrar) {

                linha.style.display = "";

                encontrados++;

            }

            else {

                linha.style.display = "none";

            }

        });


        document.getElementById(
            "total"
        ).innerText =
            "Total: " +
            encontrados +
            " registros";

    }



    /* =========================================
       LIMPAR FILTROS
    ========================================== */

    function limparFiltros() {

        document.getElementById(
            "pesquisa"
        ).value = "";


        document.getElementById(
            "dataFiltro"
        ).value = "";


        document.getElementById(
            "maquinaFiltro"
        ).value = "";


        document.getElementById(
            "statusFiltro"
        ).value = "";


        filtrar();

    }



    /* =========================================
       ATUALIZAR TOTAL
    ========================================== */

    function atualizarTotal() {

        const linhas =
            document.querySelectorAll(
                "#tabela tr"
            );


        let total = 0;


        linhas.forEach(function(linha) {

            if (
                linha.style.display !== "none"
            ) {

                total++;

            }

        });


        document.getElementById(
            "total"
        ).innerText =
            "Total: " +
            total +
            " registros";

    }



    /* =========================================
       FECHAR MODAL CLICANDO FORA
    ========================================== */

    document
        .getElementById("modal")
        .addEventListener(
            "click",
            function(event) {

                if (
                    event.target === this
                ) {

                    fecharModal();

                }

            }
        );

</script>


</body>

</html>